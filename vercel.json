{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*\\.epub)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/epub+zip"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    }
  }
}
